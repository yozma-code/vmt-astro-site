---
import Layout from '../layouts/Layout.astro';
import { TinaMarkdown } from 'tinacms/dist/rich-text';
import { tinaField } from 'tinacms/dist/react';
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

let pageData = null;
const filePath = path.join(process.cwd(), 'content/pages/home.md');
if (fs.existsSync(filePath)) {
  const fileContent = fs.readFileSync(filePath, 'utf-8');
  const { data, content } = matter(fileContent);
  pageData = { ...data, body: content };
}
---
<Layout title={pageData?.title || 'VMT 母版站'}>
  {pageData ? (
    <div>
      <div style="background: #f4f4f5; padding: 2rem; border-radius: 8px; margin-bottom: 2rem;">
        <h1 data-tina-field={tinaField(pageData, 'title')}>{pageData.title}</h1>
        <p data-tina-field={tinaField(pageData, 'seoDesc')}>{pageData.seoDesc}</p>
      </div>
      <div data-tina-field={tinaField(pageData, 'body')}>
        <TinaMarkdown content={pageData.body} />
      </div>
    </div>
  ) : (
    <div><h1>欢迎来到母版站</h1><p>请去后台创建 home.md 并保存。</p></div>
  )}
</Layout>
