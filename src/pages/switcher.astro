---
import Layout from '../layouts/Layout.astro';
---
<Layout title="VMT 4路视频切换台">
  <div class="switcher-container">
    <!-- 顶部监视器：PGM (主输出) 和 PVW (预览) -->
    <div class="monitors">
      <div class="monitor pgm-monitor">
        <div class="monitor-label bg-red">PGM (主输出)</div>
        <div id="pgm-screen" class="screen" style="background-color: #1a1a1a;">黑场 (Black)</div>
      </div>
      <div class="monitor pvw-monitor">
        <div class="monitor-label bg-green">PVW (预览)</div>
        <div id="pvw-screen" class="screen" style="background-color: #1a1a1a;">黑场 (Black)</div>
      </div>
    </div>

    <!-- 中部：四路信号源输入 -->
    <div class="inputs">
      <div class="input-box" id="input-1" onclick="selectInput(1)">
        <div class="input-num">INPUT 1</div>
        <div class="input-preview bg-cam1">会议镜头</div>
      </div>
      <div class="input-box" id="input-2" onclick="selectInput(2)">
        <div class="input-num">INPUT 2</div>
        <div class="input-preview bg-cam2">课件画面</div>
      </div>
      <div class="input-box" id="input-3" onclick="selectInput(3)">
        <div class="input-num">INPUT 3</div>
        <div class="input-preview bg-cam3">特写机位</div>
      </div>
      <div class="input-box" id="input-4" onclick="selectInput(4)">
        <div class="input-num">INPUT 4</div>
        <div class="input-preview bg-cam4">媒体播放</div>
      </div>
    </div>

    <!-- 底部控制面板 -->
    <div class="control-panel">
      <button class="btn btn-cut" onclick="cutTransition()">CUT (硬切)</button>
      <button class="btn btn-auto" onclick="autoTransition()">AUTO (软切)</button>
      <div class="transition-bar">
        <span>T-Bar (模拟)</span>
        <input type="range" id="tbar" min="0" max="100" value="0" oninput="manualTransition(this.value)">
      </div>
    </div>
  </div>
</Layout>

<style>
  .switcher-container {
    background: #222;
    padding: 20px;
    border-radius: 10px;
    color: white;
    font-family: 'Courier New', Courier, monospace;
    max-width: 1000px;
    margin: 0 auto;
  }
  .monitors {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
  }
  .monitor {
    flex: 1;
    border: 4px solid #444;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }
  .pgm-monitor { border-color: #ff3b30; box-shadow: 0 0 15px rgba(255, 59, 48, 0.4); }
  .pvw-monitor { border-color: #34c759; box-shadow: 0 0 15px rgba(52, 199, 89, 0.4); }
  .monitor-label {
    position: absolute;
    top: 0;
    left: 0;
    padding: 5px 10px;
    font-weight: bold;
    font-size: 14px;
    z-index: 10;
  }
  .bg-red { background: #ff3b30; }
  .bg-green { background: #34c759; }
  .screen {
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    transition: all 0.3s ease;
  }
  
  .inputs {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
  }
  .input-box {
    flex: 1;
    border: 2px solid #555;
    border-radius: 6px;
    cursor: pointer;
    background: #333;
    transition: all 0.2s;
  }
  .input-box:hover { border-color: #aaa; }
  .input-box.active { border-color: #34c759; background: #444; }
  .input-num {
    background: #111;
    padding: 5px;
    text-align: center;
    font-size: 12px;
    font-weight: bold;
    border-bottom: 1px solid #555;
  }
  .input-preview {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  /* 模拟不同摄像机画面的背景色 */
  .bg-cam1 { background: linear-gradient(45deg, #2c3e50, #3498db); }
  .bg-cam2 { background: linear-gradient(45deg, #8e44ad, #9b59b6); }
  .bg-cam3 { background: linear-gradient(45deg, #d35400, #e67e22); }
  .bg-cam4 { background: linear-gradient(45deg, #27ae60, #2ecc71); }

  .control-panel {
    display: flex;
    align-items: center;
    gap: 20px;
    background: #111;
    padding: 15px;
    border-radius: 8px;
  }
  .btn {
    padding: 15px 30px;
    font-size: 18px;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    color: white;
    transition: transform 0.1s;
  }
  .btn:active { transform: scale(0.95); }
  .btn-cut { background: #ff3b30; }
  .btn-auto { background: #ff9500; }
  
  .transition-bar {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .transition-bar input[type=range] {
    flex: 1;
    height: 20px;
    cursor: pointer;
  }
</style>

<script is:inline>
  let currentPvw = 0;
  let currentPgm = 0;
  
  const cameras = [
    { id: 0, name: '黑场 (Black)', bg: '#1a1a1a' },
    { id: 1, name: '会议镜头', bg: 'linear-gradient(45deg, #2c3e50, #3498db)' },
    { id: 2, name: '课件画面', bg: 'linear-gradient(45deg, #8e44ad, #9b59b6)' },
    { id: 3, name: '特写机位', bg: 'linear-gradient(45deg, #d35400, #e67e22)' },
    { id: 4, name: '媒体播放', bg: 'linear-gradient(45deg, #27ae60, #2ecc71)' }
  ];

  function selectInput(id) {
    currentPvw = id;
    // 更新 UI 高亮
    document.querySelectorAll('.input-box').forEach(el => el.classList.remove('active'));
    document.getElementById('input-' + id).classList.add('active');
    
    // 更新 PVW 监视器
    const pvwScreen = document.getElementById('pvw-screen');
    pvwScreen.innerText = cameras[id].name;
    pvwScreen.style.background = cameras[id].bg;
  }

  // CUT 硬切（瞬间把 PVW 切到 PGM）
  function cutTransition() {
    if (currentPvw === 0) return; // 不能切黑场
    currentPgm = currentPvw;
    const pgmScreen = document.getElementById('pgm-screen');
    pgmScreen.innerText = cameras[currentPgm].name;
    pgmScreen.style.background = cameras[currentPgm].bg;
  }

  // AUTO 软切（模拟 1 秒的淡入淡出）
  function autoTransition() {
    if (currentPvw === 0) return;
    const pgmScreen = document.getElementById('pgm-screen');
    // 变黑
    pgmScreen.style.opacity = '0';
    setTimeout(() => {
      currentPgm = currentPvw;
      pgmScreen.innerText = cameras[currentPgm].name;
      pgmScreen.style.background = cameras[currentPgm].bg;
      // 变亮
      pgmScreen.style.opacity = '1';
    }, 500);
  }

  // T-Bar 手动推拉
  function manualTransition(val) {
    if (val > 95) {
      cutTransition();
    }
  }
</script>
